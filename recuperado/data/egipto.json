    { "tipo": "imagen", "archivo": "egipto_f-elconfidencial-com-original-cbc-972-a09-cbc972a09600a10642f09b5212a51961-1_node-65-58.png", "node_id_figma": "65:58", "posicion": { "x": 5554, "y": 204, "width": 163, "height": 163 } },
