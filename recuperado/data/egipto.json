    { "tipo": "imagen", "archivo": "egipto_tutankamon-teorias-faraon-vida-hijos-momia-muerte-enfermedad-leyendas-egipto-home-1_node-65-60.png", "node_id_figma": "65:60", "posicion": { "x": 6015, "y": 204, "width": 212, "height": 165 } },

    { "tipo": "texto", "contenido": "En el 1060 AC comienza un gran periodo de decadencia que duró unos 700 años, Egipto nunca llegaria a recuperar su explendor pasado, a lo largo de este periodo Egipto sufrió el dominio de diferentes pueblos o civilisaciones extranjeras Libios, Palestinos, Nubios, Persas y Griegos, quienes adoptaron sus costumbres como propias.", "node_id_figma": "77:115", "posicion": { "x": 6658, "y": -134, "width": 1024, "height": 51 } },
    { "tipo": "imagen", "archivo": "egipto_screenshot-2024-09-02-at-9-42-04-am-1_node-77-117.png", "node_id_figma": "77:117", "posicion": { "x": 6658, "y": -49, "width": 751, "height": 430 } },

    { "tipo": "texto", "contenido": "El final del antiguo Egipto se da cuando el emperador romano Octavio vence al emperador romano Marco Antonio, quien era amante y aliado de la ultima faraona Cleopatra, en la batalla de Actium", "node_id_figma": "57:28", "posicion": { "x": 12610, "y": -164, "width": 334, "height": 184 } },
    { "tipo": "imagen", "archivo": "egipto_e7d4261c8786c84648d7f9efdab1ca15-1_node-57-29.png", "node_id_figma": "57:29", "posicion": { "x": 12610, "y": -73, "width": 258, "height": 331 } },

