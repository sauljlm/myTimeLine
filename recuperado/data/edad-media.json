    { "tipo": "barra_layout", "nombre_capa": "Rectangle 31", "color_hex": "#d9d9d9", "node_id_figma": "145:25", "posicion": { "x": 16829, "y": -159, "width": 2185, "height": 42 } },
    { "tipo": "texto", "contenido": "Reino de los Francos y la dinastía merovingia", "node_id_figma": "145:24", "posicion": { "x": 16850, "y": -144, "width": 349, "height": 19 } },
    { "tipo": "texto", "contenido": "481", "node_id_figma": "145:26", "posicion": { "x": 16850, "y": -185, "width": 30, "height": 19 } },
    { "tipo": "texto", "contenido": "El Reino de los Francos en la época merovingia (siglo V al VIII) fue una de las civilizaciones más importantes de la Europa medieval temprana, ubicado principalmente en lo que hoy es Francia y parte de Alemania. La dinastía merovingia fue fundada por el legendario rey Clodoveo I (466-511), quien unificó las tribus francas y expandió su territorio significativamente. Clodoveo es conocido por convertirse al cristianismo en el 496, lo que le ayudó a ganar el apoyo de la Iglesia y de los pueblos galo-romanos.", "node_id_figma": "167:26", "posicion": { "x": 16850, "y": -71, "width": 646, "height": 354 } },

    { "tipo": "texto", "contenido": "Batalla de Poitiers", "node_id_figma": "167:14", "posicion": { "x": 18646, "y": -59, "width": 141, "height": 19 } },
    { "tipo": "texto", "contenido": "732", "node_id_figma": "167:16", "posicion": { "x": 18646, "y": -93, "width": 30, "height": 19 } },
    { "tipo": "texto", "contenido": "751", "node_id_figma": "145:28", "posicion": { "x": 18967, "y": -189, "width": 28, "height": 19 } },
    { "tipo": "texto", "contenido": "Carlos Martel estaba a la cabeza de un ejercito comienza el retroceso de las fuerzas musulmanas en Europa. El nieto de Carlos Martel, Carlomagno expandió los distintos reinos francos hasta transformarlos en un imprerio.", "node_id_figma": "167:18", "posicion": { "x": 18604, "y": -27, "width": 410, "height": 152 } },
    { "tipo": "imagen", "archivo": "edadmedia_screenshot-2024-10-08-at-11-57-07-am-1_node-167-20.png", "node_id_figma": "167:20", "posicion": { "x": 18604, "y": 125, "width": 381, "height": 318 } },

    { "tipo": "texto", "contenido": "El Sacro Imperio Romano Germánico", "node_id_figma": "145:21", "posicion": { "x": 19547, "y": -159, "width": 354, "height": 24 } },
    { "tipo": "texto", "contenido": "962", "node_id_figma": "145:22", "posicion": { "x": 19547, "y": -196, "width": 40, "height": 24 } },
    { "tipo": "texto", "contenido": "Carlomagno fue coronado como Imperator Augustus por el papa León III el dia de navidad el año 800. Al morir el imperio se acabaría dividiendo en 3 entre sus nietos. Alemania y Francia se disputan el norte de Italia. Gana Alemania quien obtiene el favor del papa y la corona imperial. El resultado es el sacro imperio romano germanico", "node_id_figma": "167:21", "posicion": { "x": 19155, "y": -27, "width": 412, "height": 218 } },
    { "tipo": "imagen", "archivo": "edadmedia_screenshot-2024-10-08-at-12-02-44-pm-1_node-167-23.png", "node_id_figma": "167:23", "posicion": { "x": 19155, "y": 205, "width": 274, "height": 310 } },
    { "tipo": "texto", "contenido": "El rey Alemán Otón I es coronado emperador. Tras la desintegración del imperio Carolingico y el fracaso del proyecto político de Carlo Magno, la debilidad de los reyes se hizo evidente. Los sucesores de los reyes se vieron obligados a ceder gran parte de su autoridad a los Condes y Marqueces para obtener su apoyo. Para asegurarse la lealtad de estos nobres, los monarcas les entregaron tierras, los Feudos", "node_id_figma": "167:24", "posicion": { "x": 19621, "y": -108, "width": 412, "height": 218 } },
    { "tipo": "texto", "contenido": "Feudalismo, señores feudales", "node_id_figma": "167:9", "posicion": { "x": 19856, "y": 1478, "width": 291, "height": 24 } },

    { "tipo": "imagen", "archivo": "edadmedia_baja-edad-media-1-e1669820052308-1_node-180-28.png", "node_id_figma": "180:28", "posicion": { "x": 16848, "y": 666, "width": 602, "height": 305 } },
    { "tipo": "texto", "contenido": "Castillos 800-900", "node_id_figma": "180:29", "posicion": { "x": 19440, "y": 752, "width": 145, "height": 19 } },
    { "tipo": "texto", "contenido": "Los castillos medievales comenzaron a construirse a partir del siglo IX, en Europa occidental, tras el colapso del Imperio Carolingio y la creciente amenaza de invasiones vikingas, húngaras y sarracenas. Este periodo marcó el inicio de la Edad Media, y con la inestabilidad política y la fragmentación del poder, surgió la necesidad de estructuras defensivas robustas. Fases iniciales: Castillos de madera", "node_id_figma": "180:30", "posicion": { "x": 19440, "y": 785, "width": 416, "height": 261 } },
    { "tipo": "imagen", "archivo": "edadmedia_torre-de-londres-castillo-londres-170117120517001-1600x800-1_node-181-37.png", "node_id_figma": "181:37", "posicion": { "x": 19867, "y": 655, "width": 523, "height": 261 } },
    { "tipo": "imagen", "archivo": "edadmedia_foto1-4-1_node-181-38.png", "node_id_figma": "181:38", "posicion": { "x": 19476, "y": 1042, "width": 351, "height": 234 } },

    { "tipo": "texto", "contenido": "Fundación de las primeras universidades", "node_id_figma": "145:41", "posicion": { "x": 21195, "y": -120, "width": 400, "height": 24 } },

    { "tipo": "texto", "contenido": "Castillos 1100-1200", "node_id_figma": "181:32", "posicion": { "x": 20575, "y": 747, "width": 158, "height": 19 } },
    { "tipo": "texto", "contenido": "A lo largo de la Edad Media, los castillos se fueron perfeccionando con avances como murallas más gruesas, torres de flanqueo, puentes levadizos y fosos. Para el siglo XII y XIII, los castillos ya eran complejas fortalezas defensivas, capaces de resistir asedios prolongados y ataques con armas de sitio como catapultas y torres de asedio.", "node_id_figma": "181:34", "posicion": { "x": 20578, "y": 770, "width": 430, "height": 144 } },
    { "tipo": "imagen", "archivo": "edadmedia_screenshot-2024-10-09-at-10-14-42-am-1_node-181-36.png", "node_id_figma": "181:36", "posicion": { "x": 19827, "y": 933, "width": 713, "height": 451 } },
