                "width": 121.0,
                "height": 18.0
              }
            },
            {
              "tipo": "texto",
              "contenido": "Expansión hacia Europa: Homo erectus y otros homínidos continúan su expansión por Eurasia, alcanzando sitios en lo que hoy es España, Francia e Italia.",
              "node_id_figma": "150:77",
              "posicion": {
                "x": -2839.0,
